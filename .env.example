#
# Cybersecurity Analyzer environment variables
#

# Required (backend)
OPENAI_API_KEY=your_openai_key_here
SEMGREP_APP_TOKEN=your_semgrep_token_here

# Optional (backend)
# Set to "production" when running the single-container build
# so CORS is permissive for same-domain static hosting.
ENVIRONMENT=development

# Optional (frontend)
# Override API base URL when running frontend separately.
# In dev (localhost) the UI defaults to http://localhost:8000.
# In production (static served by FastAPI) the UI uses relative /api/* routes.
NEXT_PUBLIC_API_URL=
